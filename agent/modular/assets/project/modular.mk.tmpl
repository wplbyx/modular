.PHONY: scaffold-module scaffold-module-depend scaffold-resource scaffold-transport
.PHONY: scaffold-sync scaffold-diff scaffold-doctor scaffold-prune
.PHONY: build test test-race coverage scaffold-check contract-check verify

scaffold-module:
	$(PYTHON) $(MODULAR_TOOL) module add $(MODULE) $(foreach dependency,$(DEPENDS_ON),--depends-on $(dependency))

scaffold-module-depend:
	$(PYTHON) $(MODULAR_TOOL) module depend add $(MODULE) $(DEPENDENCY)

scaffold-resource:
	$(PYTHON) $(MODULAR_TOOL) resource add $(RESOURCE) $(if $(DRIVER),--driver $(DRIVER),) $(if $(DIALECT),--dialect $(DIALECT),)

scaffold-transport:
	$(PYTHON) $(MODULAR_TOOL) transport add $(TRANSPORT)

scaffold-sync:
	$(PYTHON) $(MODULAR_TOOL) sync

scaffold-diff:
	$(PYTHON) $(MODULAR_TOOL) $(ARGS) --diff

scaffold-doctor:
	$(PYTHON) $(MODULAR_TOOL) doctor --strict --phase framework

scaffold-prune:
	$(PYTHON) $(MODULAR_TOOL) prune $(if $(APPLY),--apply,) $(ARGS)


build:
	go build ./...

test:
	go test ./...

test-race:
	go test -race ./...

coverage:
	$(PYTHON) $(MODULAR_TOOL) coverage

scaffold-check:
	$(PYTHON) $(MODULAR_TOOL) verify --phase framework

contract-check:
	$(PYTHON) $(MODULAR_TOOL) verify --phase contract

verify:
	$(PYTHON) $(MODULAR_TOOL) verify --phase complete
